# Environment Variables Template
# Copy this file to .env and fill in real values
# DO NOT commit .env to git

# PostgreSQL
POSTGRES_USER=hazardmap
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=hazardmap

# Backend
DATABASE_URL=postgresql://hazardmap:change_me_in_production@db:5432/hazardmap
ENV=development
LOG_LEVEL=INFO

# Open-Meteo (no API key required for free tier)
# OPENMETEO_BASE_URL=https://api.open-meteo.com

# USGS Earthquake Feed (for live events WebSocket)
USGS_POLL_INTERVAL=60

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
