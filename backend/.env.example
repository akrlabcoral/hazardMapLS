# Backend Environment Variables
# Copy this file to .env and fill in real values
# DO NOT commit .env to git

DATABASE_URL=postgresql://hazardmap:change_me_in_production@db:5432/hazardmap
ENV=development
LOG_LEVEL=INFO

# Optional: Open-Meteo configuration
OPENMETEO_TIMEOUT=20
OPENMETEO_CACHE_TTL=300

# Optional: USGS live earthquake feed
USGS_POLL_INTERVAL=60

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
