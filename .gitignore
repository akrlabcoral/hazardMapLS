# =============================================================================
# HazardMap — Root .gitignore
# =============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
server/node_modules/

# ── Build Artifacts ───────────────────────────────────────────────────────────
# Never commit production builds — they are generated by CI/CD
dist/
build/
.vite/

# ── Environment Files ─────────────────────────────────────────────────────────
# CRITICAL: .env files contain secrets (DB credentials, API keys).
# Always use .env.example as the committed template.
.env
.env.local
.env.*.local
server/.env
server/.env.local

# ── OS Artifacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker Volumes (local dev) ────────────────────────────────────────────────
pgdata/
public/rasters/*.tif
frontend/public/rasters/slope_risk.tif
