# =============================================================================
# HazardMap Server — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your real values
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express API listens on.
# Must not conflict with Vite's default port (5173).
PORT=5001

# Runtime environment: development | production | test
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL + PostGIS connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Local dev (matches docker-compose.yml defaults):
DATABASE_URL=postgresql://hazardmap:hazardmap@localhost:5432/hazardmap
#
# Production example (use a secrets manager like AWS Secrets Manager or Vault):
# DATABASE_URL=postgresql://prod_user:STRONG_PASS@prod-db.internal:5432/hazardmap

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allow the frontend to call the API.
# In development this is the Vite dev server.
# In production, set this to your deployed frontend domain.
FRONTEND_ORIGIN=http://localhost:5173
