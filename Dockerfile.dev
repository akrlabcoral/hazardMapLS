# HazardMap Frontend — Dockerfile
# Development image with Vite dev server, HMR, and live reload
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies (including dev dependencies for Vite)
RUN npm install

# Copy source files
COPY src/ ./src/
COPY public/ ./public/
COPY index.html vite.config.js tailwind.config.js postcss.config.js ./

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server with HMR enabled
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
